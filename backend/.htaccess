# Proteger la base SQLite y el código interno, permitiendo servir los PDF de uploads/
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|js|json|xlsx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Código PHP interno: sólo lo usa api.php o se ejecuta en la línea de comandos
<FilesMatch "^(drive|autorizar_drive)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
