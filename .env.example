PORT=3000

# Obligatorio. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Año que usa el formulario y el dashboard por defecto
ANIO_LECTIVO=2026

# Opcionales
# JWT_DURACION=8h
# MAX_PDF_MB=10
# DRIVE_CARPETA_RAIZ=1EY74DSygnNwaxm6hWhKm5-alO-0X0Lnl
# CORS_ORIGIN=https://otro-dominio.edu.ar

# ================= INGRESO DE USUARIOS =================
# prueba  → login propio con las cuentas de prueba (desarrollo)
# externo → los usuarios llegan desde el sistema principal con un token firmado (JWT)
AUTH_MODO=prueba

# --- Sólo para AUTH_MODO=externo ---
# Clave para verificar el token: secreto compartido (HS256) o ruta a la clave pública (RS256)
# EXTERNO_JWT_SECRET=
# EXTERNO_JWT_CLAVE_PUBLICA=backend/clave_publica_sistema.pem
# Nombre de cada dato dentro del token (se admiten rutas como usuario.rol)
# EXTERNO_CLAIM_ID=sub
# EXTERNO_CLAIM_NOMBRE=name
# EXTERNO_CLAIM_ROL=role
# EXTERNO_CLAIM_EMAIL=email
# Si el token viene en una cookie del mismo dominio (si no, se manda en el link: /?token=...)
# EXTERNO_COOKIE=
# Página de inicio de sesión del sistema principal
# EXTERNO_LOGIN_URL=https://sistema.escuela.edu.ar/login

# Cómo se llaman los roles en el sistema principal (separados por coma)
# ROL_DOCENTE=docente,profesor
# ROL_ASESORA=asesora,asesor
# ROL_CONSULTA=preceptor,directivo
# ROL_ALUMNO=alumno
