PORT=3000

# ================= INGRESO (campus de la escuela) =================
# ProgMesas no tiene login propio: se entra desde el campus con un pase firmado.
# Obligatorio: la MISMA clave que PROGMESAS_SECRETO en includes/config.php del campus (32 caracteres o más).
# Para generarla:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTERNO_JWT_SECRET=
# Páginas del campus: "Ingresar" lleva a programas.php y "Cerrar sesión" a logout.php
EXTERNO_LOGIN_URL=http://localhost/campus-escuela/programas.php
EXTERNO_LOGOUT_URL=http://localhost/campus-escuela/logout.php

# Año lectivo: se calcula solo (el año en curso). Descomentar sólo para fijarlo a mano.
# ANIO_LECTIVO=2026

# Opcionales
# MAX_PDF_MB=10
# DRIVE_CARPETA_RAIZ=1EY74DSygnNwaxm6hWhKm5-alO-0X0Lnl
# DRIVE_ALCANCE=completo        # "archivos" = permiso drive.file: la app usa una carpeta propia (hay que volver a autorizar)
# DRIVE_CARPETA_NOMBRE=ProgMesas - Programas de examen
# DRIVE_DESACTIVADO=1           # guardar todo en el servidor aunque haya credenciales
# CORS_ORIGIN=https://otro-dominio.edu.ar

# Hosting (Render u otro detrás de un proxy)
# TRUST_PROXY=1                 # confiar en la IP que manda el proxy (X-Forwarded-For)
# DATOS_DIR=/var/data           # carpeta para la base y los PDF (disco persistente)

# Copias de seguridad diarias (base, PDF del servidor y asignaciones.xlsx)
# RESPALDOS_DIR=/var/respaldos/progmesas
# RESPALDO_HORA=3
# RESPALDOS_CONSERVAR=14
# GOOGLE_OAUTH_JSON={...}       # contenido de backend/oauth.json (si el archivo no está)
# GOOGLE_TOKEN_JSON={...}       # contenido de backend/token.json (si el archivo no está)

# ================= OTRO SISTEMA DE INGRESO (opcional) =================
# Con el campus no hace falta tocar nada de esto.
# Clave pública (RS256) en lugar de clave compartida
# EXTERNO_JWT_CLAVE_PUBLICA=backend/clave_publica_sistema.pem
# Nombre de cada dato dentro del pase (se admiten rutas como usuario.rol)
# EXTERNO_CLAIM_ID=sub
# EXTERNO_CLAIM_NOMBRE=name
# EXTERNO_CLAIM_ROL=role
# EXTERNO_CLAIM_EMAIL=email
# Si el pase viene en una cookie del mismo dominio (si no, se manda en el link: /?token=...)
# EXTERNO_COOKIE=
# Cómo se llaman los roles (separados por coma)
# ROL_DOCENTE=docente,profesor
# ROL_ASESORA=asesora,asesor,directivo
# ROL_CONSULTA=preceptor,director
# ROL_ALUMNO=alumno
